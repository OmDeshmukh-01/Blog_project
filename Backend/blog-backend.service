[Unit]
Description=Blog Writer FastAPI Backend
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/blog-app/backend
Environment="PATH=/home/ubuntu/blog-app/venv/bin"
EnvironmentFile=/home/ubuntu/blog-app/.env
ExecStart=/home/ubuntu/blog-app/venv/bin/uvicorn server:fastapi_app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
